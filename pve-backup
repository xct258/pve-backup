            show_vm_table(cfg)

        elif idx == 1:
            guests = guest_map()
            candidates = [v for v in sorted(guests, key=lambda x: int(x) if x.isdigit() else 0)
                          if v not in cfg["vms"]]
            if not candidates:
                print("没有可添加的虚拟机（节点上的虚拟机都已加入）")
                try:
                    input("\n按回车返回...")
                except (EOFError, KeyboardInterrupt):
