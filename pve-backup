DAEMON_UNIT = "pve-backup.service"


def write_daemon_unit() -> None:
    with open(os.path.join(UNIT_DIR, DAEMON_UNIT), "w", encoding="utf-8") as f:
        f.write(
            "[Unit]\n"
            "Description=PVE backup scheduler (daemon)\n"
            "Wants=network-online.target\n"
            "After=network-online.target pve-cluster.service pvestatd.service\n\n"
            "[Service]\n"
            "Type=simple\n"
            f"ExecStart={SELF_PATH} daemon\n"
            "Restart=always\n"
            "RestartSec=10\n"
            "Nice=10\n"
            "IOSchedulingClass=best-effort\n"
            "IOSchedulingPriority=7\n\n"
            "[Install]\n"
            "WantedBy=multi-user.target\n"
        )


def sync_service(cfg: dict) -> None:
    """重建常驻调度服务，并清理旧的 timer / 按 VM 单元。"""
    write_daemon_unit()

    stale_units = []
    for pattern in ("pve-backup-vm*.*", "pve-backup-webdav.*"):
        for path in glob.glob(os.path.join(UNIT_DIR, pattern)):
            stale_units.append(os.path.basename(path))
            try:
                os.remove(path)
            except OSError:
                pass
    for link in glob.glob(os.path.join(UNIT_DIR, "timers.target.wants", "pve-backup-*.timer")):
        try:
            os.remove(link)
        except OSError:
            pass
    for name in stale_units + [SERVICE_NAME, TIMER_NAME]:
        subprocess.run(["systemctl", "reset-failed", name], capture_output=True)

    subprocess.run(["systemctl", "daemon-reload"], capture_output=True)

    auto = str(cfg["global"].get("auto_enabled", "1")) == "1"
    if auto:
        subprocess.run(["systemctl", "enable", "--now", DAEMON_UNIT], capture_output=True)
    else:
        subprocess.run(["systemctl", "disable", "--now", DAEMON_UNIT], capture_output=True)


def write_logrotate() -> None:
    with open(LOGROTATE_FILE, "w", encoding="utf-8") as f:
        f.write(f"{LOG} {{\n    weekly\n    rotate 8\n    missingok\n    notifempty\n"
                f"    compress\n    copytruncate\n    su root root\n}}\n")


def looks_like_self(path: str) -> bool:
    try:
        with open(path, encoding="utf-8", errors="ignore") as f:
            return "pve-backup-single-file-v1" in f.read(4096)
    except OSError:
        return False


def do_install(cfg: dict, args) -> bool:
    if not require_rclone():
        return False
    section("自动注册 PVE 备份服务")
    g = cfg["global"]

    src = os.path.realpath(sys.argv[0])
    if src != SELF_PATH and looks_like_self(src):
        shutil.copy2(src, SELF_PATH)
        os.chmod(SELF_PATH, 0o755)
        say(f"  [1/6] 已安装脚本: {SELF_PATH}")
    else:
        try:
            os.chmod(SELF_PATH, 0o755)
            say(f"  [1/6] 脚本已就位: {SELF_PATH}")
        except OSError:
            say(f"  [1/6] 警告: 找不到 {SELF_PATH}，请从脚本副本重新执行 install")
            return False

    if getattr(args, "url", None):
        if not args.user:
            say("错误: --url 需要同时提供 --user")
            return False
        obscured = subprocess.run([RCLONE, "obscure", args.passwd or ""],
                                  capture_output=True, text=True).stdout.strip()
        rc = subprocess.run(
            [RCLONE, "config", "create", g["remote"], "webdav",
             f"url={args.url}", "vendor=other", f"user={args.user}",
             f"pass={obscured}", "--config", RCLONE_CONFIG],
            capture_output=True, text=True).returncode
        say(f"  [2/6] {'已注册' if rc == 0 else '注册失败'} rclone remote: {g['remote']}")
    elif rclone_remote_exists(g.get("remote", "")):
        say(f"  [2/6] rclone remote 已存在: {g['remote']}")
    else:
        say(f"  [2/6] 警告: rclone remote '{g.get('remote')}' 不存在")

    if getattr(args, "vmid", None):
        for vmid in str(args.vmid).split():
            add_vm(cfg, vmid, {}, overwrite=True)
    for key in ("mode", "compress"):
        val = getattr(args, key, None)
        if val:
            g[key] = val
    if getattr(args, "prune", None) is not None:
        g["local_prune"] = args.prune
    if getattr(args, "paths", None) is not None:
        g["remote_paths"] = args.paths
    elif getattr(args, "subdir", None) is not None:
        g["remote_paths"] = args.subdir
    if getattr(args, "host", None):
        g["host_name"] = args.host
    if getattr(args, "keep", None) is not None:
        g["remote_keep"] = args.keep

    if getattr(args, "no_timer", False):
        g["auto_enabled"] = "0"

    save_conf(cfg)
    say(f"  [3/6] 已写入配置: {CONF}")

    write_logrotate()
    say(f"  [4/6] 已生成日志轮转: {LOGROTATE_FILE}")

    sync_service(cfg)
    n = len(cfg["vms"])
    say(f"  [5/6] 已生成调度服务（{n} 个备份计划）")

    auto = str(g.get("auto_enabled", "1")) == "1"
    say(f"  [6/6] 自动备份: {'已开启' if auto else '已关闭'}")

    section("注册完成")
    print(f"  脚本     : {SELF_PATH}")
    print(f"  配置     : {CONF}")
    print(f"  调度服务 : {DAEMON_UNIT}")
    print(f"  备份计划 : {n} 个")
    print(f"  自动备份 : {'已开启' if auto else '已关闭'}")
    print(f"  虚拟机   : {', '.join(sorted(cfg['vms'])) or '(未配置)'}")
    print(f"  日志     : {LOG}")
    return True


