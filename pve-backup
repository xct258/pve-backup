DAY_CN = {"mon": "一", "tue": "二", "wed": "三", "thu": "四",
          "fri": "五", "sat": "六", "sun": "日"}


def schedule_text(spec: str) -> str:
    spec = str(spec or "").strip()
    if not spec:
        return "-"
    parts = spec.split()
    head = parts[0].lower()
    if head == "daily" and len(parts) >= 2:
        return f"每天 {parts[1]}"
    if head == "weekly" and len(parts) >= 3:
        day = DAY_CN.get(parts[1].lower()[:3], parts[1])
        return f"每周{day} {parts[2]}"
    if head == "monthly" and len(parts) >= 3 and parts[1].isdigit():
        return f"每月 {int(parts[1])} 号 {parts[2]}"
    if ":" in spec and " " not in spec:
        return f"每天 {spec}"
    return spec


