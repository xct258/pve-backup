def _ui_action(scr, key, info) -> tuple:
    cfg = info["cfg"]
    if key == "quit":
        return "", True
    if key == "run":
        if not info["vms_on"]:
            _ui_msg(scr, "无法备份", "没有已启用的虚拟机，请先在「虚拟机管理」中添加")
            return "", False
        if not _ui_confirm(scr, f"立即备份 {info['vms_on']} 台虚拟机？"):
            return "已取消", False
        rc = _ui_suspend(scr, act_run, load_conf())
        _ui_bust()
        return f"备份结束（退出码 {rc}）", False
    if key == "upload":
        if not _ui_confirm(scr, "补传本地未上传的备份？"):
            return "已取消", False
        rc = _ui_suspend(scr, act_upload, load_conf())
        _ui_bust()
        return f"补传结束（退出码 {rc}）", False
    if key == "list":
        text = _ui_capture(act_list, load_conf())
        _ui_pager(scr, "本地 / 远端备份明细", text)
        return "", False
    if key == "status":
        text = _ui_capture(act_status, load_conf())
        _ui_pager(scr, "运行状态", text)
        return "", False
    if key == "notify":
        text = _ui_capture(push_notify, cfg, "info",
                           "**测试推送**：来自 pve-backup 仪表盘 🎉",
                           "PVE 备份 · 测试推送")
        _ui_pager(scr, "推送结果", text)
        return "推送测试完成", False
    if key == "vms":
        _ui_vm_view(scr)
        _ui_bust()
        return "", False
    if key == "global":
        _ui_global_view(scr)
        _ui_bust()
        return "", False
    if key == "service":
        _ui_service_view(scr)
        _ui_bust()
        return "", False
    return "", False


def _ui_dashboard() -> None:
    if curses is None or not (sys.stdin.isatty() and sys.stdout.isatty()):
        plain_menu()
        return

    def _loop(scr):
        _ui_setup(scr)
        rows = _ui_rows()
        sel = _ui_first_item(rows)
        msg = ""
        while True:
            rows = _ui_rows()
            _ui_draw_dashboard(scr, rows, sel, msg)
            scr.refresh()
            ch = _ui_key(scr)
            msg = ""
            if isinstance(ch, int):
                if ch == curses.KEY_UP:
                    sel = _ui_move(rows, sel, -1)
                elif ch == curses.KEY_DOWN:
                    sel = _ui_move(rows, sel, 1)
                elif ch in (curses.KEY_RESIZE,):
                    continue
                elif ch in (10, 13, curses.KEY_ENTER):
                    key = rows[sel]["key"]
                    msg, quit_now = _ui_action(scr, key, _ui_info())
                    if quit_now:
                        return
                elif ch in (27,):
                    return
                continue
            if ch in ("q", "\x1b"):
                return
            if ch in ("j", "k"):
                sel = _ui_move(rows, sel, 1 if ch == "j" else -1)
                continue
            if ch == "\n":
                key = rows[sel]["key"]
                msg, quit_now = _ui_action(scr, key, _ui_info())
                if quit_now:
                    return
                continue
            hot = {r["hot"]: r["key"] for r in rows if r["kind"] == "item"}
            if ch in hot:
                msg, quit_now = _ui_action(scr, hot[ch], _ui_info())
                if quit_now:
                    return

    try:
        curses.wrapper(_loop)
    except KeyboardInterrupt:
        pass


ITEMS = [
    ("status",  "查看自动备份状态"),
    ("manual",  "手动备份（执行 / 补传）"),
    ("list",    "查看本地/远端备份明细"),
    ("vms",     "管理虚拟机备份（增删改）"),
    ("edit",    "修改全局配置"),
    ("service", "服务管理（启用 / 注册 / 卸载）"),
    ("quit",    "退出"),
]


def manual_menu(cfg: dict) -> None:
    idx = pick("手动备份", [
        "执行一次完整备份 + 上传",
        "只补传本地未上传的备份",
        "返回",
    ])
    if idx == 0:
        act_run(cfg)
    elif idx == 1:
        act_upload(cfg)


def service_menu(cfg: dict) -> None:
    while True:
        total = sum(1 for v in cfg["vms"]
                    if str(cfg["vms"][v].get("enabled", "1")).strip() != "0")
        auto = str(cfg["global"].get("auto_enabled", "1")) == "1"
        running = run_capture(["systemctl", "is-active", DAEMON_UNIT]) == "active"

        if total == 0:
            state = "未配置虚拟机"
            toggle_label = "开启自动备份"
            is_on = False
        elif auto and running:
            state = "已开启（调度服务运行中）"
            toggle_label = "关闭自动备份"
            is_on = True
        elif auto:
            state = "已启用但服务未运行"
            toggle_label = "关闭自动备份"
            is_on = True
        else:
            state = "已关闭"
            toggle_label = "开启自动备份"
            is_on = False

        idx = pick(f"服务管理（当前：{state}）", [
            toggle_label,
            "重新注册备份服务",
            "重置调度状态",
            "卸载备份服务",
            "返回",
        ])
        if idx is None or idx == 4:
            return

        if idx == 0:
            if is_on:
                cfg["global"]["auto_enabled"] = "0"
                save_conf(cfg)
                sync_service(cfg)
                print("已关闭自动备份（手动备份仍可用）")
            else:
                cfg["global"]["auto_enabled"] = "1"
                save_conf(cfg)
                sync_service(cfg)
                print("已开启自动备份（调度服务常驻运行）")
        elif idx == 1:
            do_install(cfg, argparse.Namespace(url=None, user=None, passwd=None,
                                               force=True, no_timer=False, vmid=None,
                                               preserve_state=True))
        elif idx == 2:
            do_reset()
        elif idx == 3:
            if confirm("确认卸载备份服务？配置和备份会保留", "是，卸载", "否，取消"):
                do_uninstall()

        try:
            input("\n按回车返回...")
        except (EOFError, KeyboardInterrupt):
            return


def _dispatch(key: str, cfg: dict) -> None:
    if key == "status":
        act_status(cfg)
    elif key == "manual":
        manual_menu(cfg)
    elif key == "list":
        act_list(cfg)
    elif key == "vms":
        interactive_vm_menu(cfg)
    elif key == "config":
        act_config(cfg)
    elif key == "edit":
        edit_global_config(cfg)
    elif key == "service":
        service_menu(cfg)


def interactive_menu() -> None:
    """有 TTY 时进入全屏仪表盘，否则退回纯文本菜单。"""
    _ui_dashboard()


def plain_menu() -> None:
    while True:
        section("PVE 备份管理")
        for i, (_, label) in enumerate(ITEMS, 1):
            print(f"  {i}) {label}")
        print("")
        try:
            c = input("请选择: ").strip()
        except (EOFError, KeyboardInterrupt):
            return
        if c in ("0", "q", "Q"):
            return
        if not c.isdigit() or not (1 <= int(c) <= len(ITEMS)):
            print("无效选择")
            continue
        key = ITEMS[int(c) - 1][0]
        if key == "quit":
            return
        cfg = load_conf()
        try:
            _dispatch(key, cfg)
        except Exception as e:
            print(f"执行出错: {e}")
        try:
            input("\n按回车返回菜单...")
        except (EOFError, KeyboardInterrupt):
            return


# ------------------------------------------------------------------ CLI
def build_install_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(prog="pve-backup install")
    ap.add_argument("--vmid", help="要加入备份的 VMID，多个用空格分隔")
    ap.add_argument("--mode", choices=["snapshot", "suspend", "stop"])
    ap.add_argument("--compress", choices=["zstd", "gzip", "lzo", "0"])
    ap.add_argument("--prune")
    ap.add_argument("--subdir")
    ap.add_argument("--paths", help="多个远端基础目录，逗号分隔")
    ap.add_argument("--host", help="远端主机子目录名（默认系统主机名）")
    ap.add_argument("--keep", help="保留最新 N 个时间文件夹")
    ap.add_argument("--url")
    ap.add_argument("--user")
    ap.add_argument("--pass", dest="passwd")
    ap.add_argument("--force", action="store_true")
    ap.add_argument("--no-timer", action="store_true")
    return ap


def print_help() -> None:
    print(__doc__)


def main() -> int:
    if os.geteuid() != 0:
        print("需要 root 权限", file=sys.stderr)
        return 1

    argv = sys.argv[1:]
    if not argv:
        if not require_rclone():
            return 1
        if sys.stdin.isatty() and sys.stdout.isatty():
            interactive_menu()
        else:
            act_status(load_conf())
        return 0

    cmd, rest = argv[0], argv[1:]
    cfg = load_conf()

    if cmd in ("help", "-h", "--help"):
        print_help()
        return 0
    if cmd == "menu":
        if not require_rclone():
            return 1
        interactive_menu()
        return 0
    if cmd == "status":
        act_status(cfg)
        return 0
    if cmd == "run":
        return act_run(cfg, rest[0] if rest else None)
    if cmd == "daemon":
        return cmd_daemon()
    if cmd == "upload":
        return act_upload(cfg)
    if cmd == "list":
        act_list(cfg)
        return 0
    if cmd == "config":
        act_config(cfg)
        return 0
    if cmd == "vms":
        show_vm_table(cfg)
        return 0
    if cmd == "notify":
        msg = " ".join(rest) if rest else "这是一条来自 pve-backup 的测试消息 🎉"
        ok = push_notify(cfg, "info", msg, title="PVE 备份 · 测试推送")
        return 0 if ok else 1
    if cmd == "add":
        a = parse_vm_options(rest)
        add_vm(cfg, a["vmid"], vm_values_from_args(a), overwrite=False)
        return 0
    if cmd == "edit":
        a = parse_vm_options(rest)
        if str(a["vmid"]) not in cfg["vms"]:
            print(f"VMID {a['vmid']} 不在配置中，使用 add 添加")
            return 1
        add_vm(cfg, a["vmid"], vm_values_from_args(a), overwrite=True)
        return 0
    if cmd == "remove":
        if not rest:
            print("用法: pve-backup remove <vmid>")
            return 2
        remove_vm(cfg, rest[0])
        return 0
    if cmd == "install":
        args = build_install_parser().parse_args(rest)
        return 0 if do_install(cfg, args) else 1
    if cmd == "reset":
        do_reset()
        return 0
    if cmd == "uninstall":
        do_uninstall()
        return 0

    print(f"未知命令: {cmd}")
    print_help()
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("\n已取消")
        sys.exit(130)
