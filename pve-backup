        elif key == "compress":
            v = _ui_choice(scr, "压缩算法", ["zstd", "gzip", "lzo", "0（不压缩）"])
            if v is not None:
                vm[key] = ["zstd", "gzip", "lzo", "0"][v]
        elif key == "local_prune":
            v = _ui_input(scr, "本机保留策略", vm.get("local_prune", ""),
                          "如 keep-last=3，留空表示继承全局")
            if v is not None:
                vm[key] = v.strip()
        elif key in ("delete_local", "verify_hash"):
            v = _ui_choice(scr, "选择值", ["开启", "关闭"],
                           default=0 if str(vm.get(key, p[key])) == "1" else 1)
            if v is not None:
                vm[key] = "1" if v == 0 else "0"
        elif key == "enabled":
            v = _ui_choice(scr, "启用这台虚拟机的备份？", ["开启", "关闭"],
                           default=0 if p["enabled"] else 1)
            if v is not None:
