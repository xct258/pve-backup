            vmid = candidates[choice]
            if vmid:
                add_vm(cfg, vmid, {})
                cfg = load_conf()
                edit_vm_interactive(cfg, vmid)

        elif idx == 2:
            vmid = pick_vm(cfg, "选择要修改的虚拟机")
            if vmid:
                edit_vm_interactive(cfg, vmid)

        elif idx == 3:
            vmid = pick_vm(cfg, "选择要删除的虚拟机")
            if vmid and confirm(f"确认从备份列表移除 VM {vmid}？", "是，移除", "否，取消"):
                remove_vm(cfg, vmid)

        elif idx == 4:
            vmid = pick_vm(cfg, "选择要启用/停用的虚拟机")
            if vmid:
                cur = cfg["vms"][vmid].get("enabled", "1")
                new = "0" if cur != "0" else "1"
                cfg["vms"][vmid]["enabled"] = new
                save_conf(cfg)
                sync_service(cfg)
                print(f"VM {vmid} 已{'启用' if new == '1' else '停用'}")

        try:
            input("\n按回车返回...")
        except (EOFError, KeyboardInterrupt):
            return


def edit_vm_interactive(cfg: dict, vmid: str) -> None:
    cfg["vms"].setdefault(vmid, {"enabled": "1"})
    guests = guest_map()
    while True:
        p = target_params(cfg, vmid, guests)
        labels = [
            ("mode", f"备份模式: {p['mode']}"),
            ("compress", f"压缩: {p['compress']}"),
            ("local_prune", f"本机保留: {p['local_prune']}"),
            ("delete_local", f"上传后删本地: {p['delete_local']}"),
            ("verify_hash", f"SHA256 校验: {p['verify_hash']}"),
            ("enabled", f"启用: {'1' if p['enabled'] else '0'}"),
        ]
        idx = pick(f"修改 VM {vmid}（{p['name'] or '-'}）参数",
                   [x[1] for x in labels] + ["完成并返回"])
        if idx is None or idx == len(labels):
            save_conf(cfg)
            print(f"VM {vmid} 参数已保存")
            return

        key = labels[idx][0]
        vm = cfg["vms"][vmid]

        if key == "mode":
            v = pick("选择备份模式", ["snapshot（快照，不停机）",
                                     "suspend（短暂挂起）",
                                     "stop（关机备份）"])
            if v is not None:
                vm[key] = ["snapshot", "suspend", "stop"][v]
        elif key == "compress":
            v = pick("选择压缩算法", ["zstd", "gzip", "lzo", "0（不压缩）"])
            if v is not None:
                vm[key] = ["zstd", "gzip", "lzo", "0"][v]
        elif key in ("delete_local", "verify_hash", "enabled"):
            if key == "enabled":
                cur_on = "1" if p["enabled"] else "0"
            else:
                cur_on = str(vm.get(key, "")).strip() or p[key]
            v = pick("选择值", ["1（开启）", "0（关闭）"],
                     default=0 if cur_on == "1" else 1)
            if v is not None:
                vm[key] = "1" if v == 0 else "0"
        else:
            try:
                v = input(f"{labels[idx][1]}\n输入新值（直接回车保持当前值）: ").strip()
            except (EOFError, KeyboardInterrupt):
                continue
            if v or key == "local_prune":
                vm[key] = v

        save_conf(cfg)
        sync_service(cfg)


