# ------------------------------------------------------------------ 备份
def act_run(cfg: dict, only: str = None) -> int:
    global LOGGING
    LOGGING = True
    if not require_rclone():
        return 1

    if only is not None:
        only = str(only)
        if only not in cfg["vms"]:
            say(f"错误: VMID {only} 不在配置中")
            return 1
        vms = [only]
    else:
        vms = enabled_vmids(cfg)
    if not vms:
        say("错误: 没有已启用的虚拟机，请先 add")
        return 1
    g = cfg["global"]
    if not rclone_remote_exists(g.get("remote", "")):
        say(f"错误: rclone remote '{g.get('remote')}' 不存在")
        return 1

    lock = acquire_lock()
    if lock is None:
        say("错误: 等待运行锁超时，已有实例在运行")
        return 1

    try:
        section(f"PVE 备份开始 {dt.datetime.now():%Y-%m-%d %H:%M:%S}")
        say(f"  计划虚拟机: {', '.join(vms)}")
        say(f"  本地目录  : {g.get('dumpdir')}（存储 {g.get('storage')}）")
        run_stamp = run_dir_name()
        run_dirs = [f"{b}/{run_stamp}" for b in remote_bases(cfg)]
        say("  远端目录  :")
        for d in run_dirs:
            say(f"    {d}")

        t_all = time.time()
        rows = []
        overall_fail = 0
        guests = guest_map()

        for vmid in vms:
            p = target_params(cfg, vmid, guests)
            name = p["name"] or "-"

            section(f"备份 VM {vmid} ({name})")
            say(f"  模式 {p['mode']} / 压缩 {p['compress']} / 本机保留 {p['local_prune']}")

            marker = f"{MARKER}.{vmid}"
            open(marker, "w").close()
            mm = os.path.getmtime(marker)

            cmd = ["vzdump", str(vmid), "--storage", p["storage"],
                   "--mode", p["mode"], "--compress", p["compress"]]
            if p["local_prune"]:
                cmd += ["--prune-backups", p["local_prune"]]

            say("")
            say(">>> 调用 vzdump ...")
            rc = run_stream(cmd, to_log=True)
            if rc != 0:
                say(f"!!! VM {vmid} 备份失败 (退出码 {rc})，跳过上传")
                rows.append((vmid, name, "-", 0, 0, "backup-failed"))
                overall_fail = 1
                continue

            files = sorted(
                f for f in archive_files(p["dumpdir"])
                if os.path.getmtime(f) >= mm
            )
            if not files:
                say("未发现本次新生成的归档（可能被保留策略清理）")
                rows.append((vmid, name, "-", 0, 0, "no-archive"))
                continue

            for f in files:
                size = os.path.getsize(f)
                dur_sum = 0
                st = "ok"
                for rd in run_dirs:
                    s, _, d = upload_file(p, f, rd, allow_delete=False)
                    dur_sum += d
                    if s == "failed":
                        st = "failed"
                    elif s == "skipped" and st == "ok":
                        st = "skipped"
                if st != "failed" and p["delete_local"] == "1":
                    try:
                        os.remove(f)
                        say(f"  [清理] 已删除本地 {os.path.basename(f)}")
                    except OSError as e:
                        say(f"  [警告] 删除本地失败: {e}")
                rows.append((vmid, name, os.path.basename(f), size, dur_sum, st))
                if st == "failed":
                    overall_fail = 1

        keep_msg = enforce_folder_keep(cfg)
        if keep_msg:
            say("")
            say(f"  远端清理: {keep_msg}")

        total = int(time.time() - t_all)
        total_size = sum(r[3] for r in rows if r[5] == "ok")
        section("备份汇总")
        print(f"  {pad('总耗时', 10)} {total}s")
        print(f"  {pad('虚拟机数', 10)} {len(vms)}")
        print(f"  {pad('本次上传', 10)} {hsize(total_size)}")
        print(f"  {pad('远端目录', 10)} {' | '.join(run_dirs)}")
        print("")
        print("  " + pad("VMID", 7) + pad("名称", 18) + pad("文件", 40)
              + f"{'大小':>10} {'耗时':>5}  结果")
        for vmid, name, base, size, dur, st in rows:
            print("  " + pad(vmid, 7) + pad(name[:16], 18) + pad(base, 40)
                  + f"{hsize(size):>10} {dur:>4}s  {st}")

        say("")
        if overall_fail:
            say("  状态: ❌ 存在失败（可执行 upload 重试）")
        else:
            say("  状态: ✅ 全部成功")
        section(f"结束 {dt.datetime.now():%Y-%m-%d %H:%M:%S}")
        return 1 if overall_fail else 0
    finally:
        try:
            fcntl.flock(lock, fcntl.LOCK_UN)
            lock.close()
        except Exception:
            pass
        LOGGING = False


def act_upload(cfg: dict) -> int:
    global LOGGING
    LOGGING = True
    if not require_rclone():
        return 1
    g = cfg["global"]
    if not rclone_remote_exists(g.get("remote", "")):
        say(f"错误: rclone remote '{g.get('remote')}' 不存在")
        return 1
    lock = acquire_lock()
    if lock is None:
        say("错误: 等待运行锁超时")
        return 1
    try:
        section("仅上传模式：按备份时间放入对应的时间文件夹")
        fail = 0
        any_file = False
        bases = remote_bases(cfg)
        guests = guest_map()
        for vmid in sorted(cfg["vms"], key=lambda x: int(x) if x.isdigit() else 0):
            p = target_params(cfg, vmid, guests)
            files = archive_files(p["dumpdir"], vmid)
            if not files:
                continue
            any_file = True
            for f in files:
                stamp = run_dir_name(dt.datetime.fromtimestamp(os.path.getmtime(f)))
                dirs = [f"{b}/{stamp}" for b in bases]
                say("")
                say(f"  VM {vmid} -> {', '.join(dirs)}")
                st = "ok"
                for rd in dirs:
                    s, _, _ = upload_file(p, f, rd, allow_delete=False)
                    if s == "failed":
                        st = "failed"
                if st != "failed" and p["delete_local"] == "1":
                    try:
                        os.remove(f)
                        say(f"  [清理] 已删除本地 {os.path.basename(f)}")
                    except OSError as e:
                        say(f"  [警告] 删除本地失败: {e}")
                if st == "failed":
                    fail = 1
        keep_msg = enforce_folder_keep(cfg)
        if keep_msg:
            say(f"  远端清理: {keep_msg}")
        if not any_file:
            say("  本地没有可上传的备份")
        say("  结果: ✅ 全部就绪" if fail == 0 else "  结果: ❌ 部分上传失败")
        return 1 if fail else 0
    finally:
        try:
            fcntl.flock(lock, fcntl.LOCK_UN)
            lock.close()
        except Exception:
            pass
        LOGGING = False


