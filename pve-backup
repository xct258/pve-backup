def _ui_setup(scr) -> None:
    scr.keypad(True)
    try:
        curses.curs_set(0)
    except Exception:
        pass
    if curses.has_colors():
        try:
            curses.start_color()
            curses.use_default_colors()
            curses.init_pair(1, curses.COLOR_CYAN, -1)
            curses.init_pair(2, curses.COLOR_GREEN, -1)
            curses.init_pair(3, curses.COLOR_RED, -1)
            curses.init_pair(4, curses.COLOR_YELLOW, -1)
        except Exception:
            pass


def _ui_color(pair: int):
    if curses.has_colors():
        try:
            return curses.color_pair(pair)
        except Exception:
            return 0
    return 0


def _ui_capture(func, *args, **kwargs) -> str:
    """捕获函数的标准输出，供弹层展示。"""
    buf = io.StringIO()
    old = sys.stdout
    sys.stdout = buf
    try:
        func(*args, **kwargs)
    except Exception as e:  # 捕获异常也要能看到
        print(f"执行出错: {e}")
    finally:
        sys.stdout = old
    return buf.getvalue()


def _ui_suspend(scr, func, *args) -> int:
    """退出 curses 执行长任务（保持进度输出），结束后返回仪表盘。"""
    curses.def_prog_mode()
    curses.endwin()
    rc = 1
    try:
        rc = func(*args) or 0
    except Exception as e:
        print(f"\n执行出错: {e}")
    try:
        input("\n按回车返回仪表盘...")
    except (EOFError, KeyboardInterrupt):
        pass
    curses.reset_prog_mode()
    scr.clear()
    return rc


def _ui_msg(scr, title, text, wait="按任意键返回") -> None:
    lines = str(text).rstrip("\n").split("\n")
    while True:
        h, w = scr.getmaxyx()
        bw = min(w - 4, max(40, max([_ui_width(x) for x in lines] + [_ui_width(title)]) + 8))
        bh = min(h - 2, len(lines) + 4)
        y0 = max(0, (h - bh) // 2)
        x0 = max(0, (w - bw) // 2)
        scr.erase()
        _ui_box(scr, y0, x0, bh, bw, title)
        for i, ln in enumerate(lines[: bh - 3]):
            _ui_add(scr, y0 + 2 + i, x0 + 2, ln)
        _ui_add(scr, y0 + bh - 1, x0 + 2, f" {wait} ")
        scr.refresh()
        ch = _ui_key(scr)
        if ch is not None:
            return


def _ui_choice(scr, title, options, default=0):
    if not options:
        return None
    pos = min(max(default, 0), len(options) - 1)
    while True:
        h, w = scr.getmaxyx()
        bw = min(w - 4, max(36, max([_ui_width(o) for o in options] + [_ui_width(title)]) + 8))
        bh = min(h - 2, len(options) + 4)
        y0 = max(0, (h - bh) // 2)
        x0 = max(0, (w - bw) // 2)
        scr.erase()
        _ui_box(scr, y0, x0, bh, bw, title)
        for i, opt in enumerate(options):
            attr = curses.A_REVERSE if i == pos else 0
            _ui_add(scr, y0 + 2 + i, x0 + 2,
                    " " + pad(opt, bw - 6) + " ", attr)
        _ui_add(scr, y0 + bh - 1, x0 + 2, " ↑/↓ 选择  Enter 确认  q 取消 ")
        scr.refresh()
        ch = _ui_key(scr)
        if isinstance(ch, int):
            if ch == curses.KEY_UP:
                pos = (pos - 1) % len(options)
            elif ch == curses.KEY_DOWN:
                pos = (pos + 1) % len(options)
            elif ch in (10, 13, curses.KEY_ENTER):
                return pos
            elif ch in (27, ord("q")):
                return None
        elif ch in ("k", "j"):
            pos = (pos + (-1 if ch == "k" else 1)) % len(options)
        elif ch == "\n":
            return pos
        elif ch in ("q", "\x1b"):
            return None


def _ui_input(scr, title, default="", hint=""):
    buf = str(default)
    pos = len(buf)
    while True:
        h, w = scr.getmaxyx()
        bw = min(w - 4, max(48, _ui_width(buf) + 8))
        bh = 6
        y0 = max(0, (h - bh) // 2)
        x0 = max(0, (w - bw) // 2)
        scr.erase()
        _ui_box(scr, y0, x0, bh, bw, title)
        if hint:
            _ui_add(scr, y0 + 1, x0 + 2, hint, curses.A_DIM)
        _ui_add(scr, y0 + 3, x0 + 2, buf[: bw - 4])
        try:
            curses.curs_set(1)
            scr.move(y0 + 3, min(x0 + 2 + _ui_width(buf[:pos]), w - 2))
        except Exception:
            pass
        _ui_add(scr, y0 + bh - 1, x0 + 2, " Enter 确认  Esc 取消 ")
        scr.refresh()
        ch = _ui_key(scr)
        if isinstance(ch, int):
            if ch in (10, 13, curses.KEY_ENTER):
                try:
                    curses.curs_set(0)
                except Exception:
                    pass
                return buf
            if ch == 27:
                try:
                    curses.curs_set(0)
                except Exception:
                    pass
                return None
            if ch in (curses.KEY_BACKSPACE, 127, 8):
                if pos > 0:
                    buf = buf[: pos - 1] + buf[pos:]
                    pos -= 1
            elif ch == curses.KEY_DC:
                buf = buf[:pos] + buf[pos + 1:]
            elif ch == curses.KEY_LEFT:
                pos = max(0, pos - 1)
            elif ch == curses.KEY_RIGHT:
                pos = min(len(buf), pos + 1)
            elif ch == curses.KEY_HOME:
                pos = 0
            elif ch == curses.KEY_END:
                pos = len(buf)
        elif isinstance(ch, str) and ch.isprintable():
            buf = buf[:pos] + ch + buf[pos:]
            pos += 1
        elif ch == "\x1b":
            try:
                curses.curs_set(0)
            except Exception:
                pass
            return None


def _ui_confirm(scr, title, yes="是，继续", no="否，取消") -> bool:
    return _ui_choice(scr, title, [no, yes], default=0) == 1


def _ui_pager(scr, title, text) -> None:
    lines = str(text).rstrip("\n").split("\n") or [""]
    top = 0
    while True:
        h, w = scr.getmaxyx()
        scr.erase()
        _ui_box(scr, 0, 0, h, w, title)
        body = max(1, h - 4)
        for i, ln in enumerate(lines[top: top + body]):
            _ui_add(scr, 2 + i, 2, ln)
        more = "  ↑/↓ 滚动  PgUp/PgDn 翻页  Enter/q 返回 "
        if top + body < len(lines):
            more = f" [{top + body}/{len(lines)}] " + more
        _ui_add(scr, h - 1, 2, more, curses.A_DIM)
        scr.refresh()
        ch = _ui_key(scr)
        if isinstance(ch, int):
            if ch == curses.KEY_UP:
                top = max(0, top - 1)
            elif ch == curses.KEY_DOWN:
                top = min(max(0, len(lines) - body), top + 1)
            elif ch == curses.KEY_PPAGE:
                top = max(0, top - body)
            elif ch == curses.KEY_NPAGE:
                top = min(max(0, len(lines) - body), top + body)
            elif ch == curses.KEY_HOME:
                top = 0
            elif ch == curses.KEY_END:
                top = max(0, len(lines) - body)
            elif ch in (10, 13, 27, curses.KEY_ENTER):
                return
        elif ch in ("q", "\x1b", "\n", "\r"):
            return


def _ui_info() -> dict:
    now = time.time()
    if _UI_CACHE["info"] and now - _UI_CACHE["ts"] < 3:
        return _UI_CACHE["info"]
    cfg = load_conf()
    g = cfg["global"]
    running = run_capture(["systemctl", "is-active", DAEMON_UNIT]).strip() == "active"
    nxt = next_run(g.get("schedule"))
    info = {
        "cfg": cfg,
        "host": host_label(cfg),
        "auto": str(g.get("auto_enabled", "1")) == "1",
        "running": running,
        "schedule": schedule_text(g.get("schedule")),
        "next": nxt.strftime("%Y-%m-%d %H:%M") if nxt else "-",
        "vms": len(cfg["vms"]),
        "vms_on": len(enabled_vmids(cfg)),
        "remote": g.get("remote", ""),
        "paths": g.get("remote_paths", ""),
        "keep": g.get("remote_keep", ""),
        "notify_on": g.get("notify_on", ""),
        "notify_url": g.get("notify_url", ""),
    }
    _UI_CACHE.update(ts=now, info=info)
    return info


def _ui_rows() -> list:
    rows = []
    for group, items in UI_GROUPS:
        rows.append({"kind": "group", "label": group})
        for key, label, hot in items:
            rows.append({"kind": "item", "key": key, "label": label, "hot": hot})
    return rows


def _ui_first_item(rows) -> int:
    for i, r in enumerate(rows):
        if r["kind"] == "item":
            return i
    return 0


def _ui_move(rows, sel, step) -> int:
    n = len(rows)
    i = sel
    for _ in range(n):
        i = (i + step) % n
        if rows[i]["kind"] == "item":
            return i
    return sel


def _ui_header(info) -> list:
    g = info["cfg"]["global"]
    auto = info["auto"]
    if auto and info["running"]:
        auto_txt = "✅ 已开启"
    elif auto:
        auto_txt = "⚠ 已启用但服务未运行"
    else:
        auto_txt = "⏸ 已关闭"
    svc = "● active" if info["running"] else "○ inactive"
    push = f"{info['notify_on'] or '-'} · {info['notify_url'] or '未配置'}"
    lines = [
        ("主机", info["host"], 0),
        ("自动备份", f"{auto_txt} · {info['schedule']} · 下次 {info['next']}", 0),
        ("调度服务", svc, 0),
        ("虚拟机", f"{info['vms']} 台（启用 {info['vms_on']}）", 0),
        ("远端", f"{info['remote']} → {info['paths'] or '未配置'} · 保留 {info['keep']}", 0),
        ("推送", push, 0),
    ]
    return lines


def _ui_draw_dashboard(scr, rows, sel, msg) -> None:
    scr.erase()
    h, w = scr.getmaxyx()
    if h < 16 or w < 52:
        _ui_add(scr, 0, 0, "终端窗口太小，请调整到至少 52x16 后重试。")
        scr.refresh()
        return
    info = _ui_info()
    head = _ui_header(info)
    hh = len(head) + 2
    _ui_box(scr, 0, 0, hh, w, "pve-backup · 备份管理")
    for i, (label, value, attr) in enumerate(head):
        _ui_add(scr, 1 + i, 2, pad(label, 10), curses.A_BOLD)
        _ui_add(scr, 1 + i, 2 + 10, value, attr)

    y = hh + 1
    for i, row in enumerate(rows):
        if row["kind"] == "group":
            _ui_add(scr, y, 2, row["label"], curses.A_BOLD | _ui_color(1))
            y += 1
            continue
        selected = i == sel
        left = ("▸ " if selected else "  ") + row["label"]
        right = f"[{row['hot']}]"
        text = " " + pad(left, max(1, w - 8 - _ui_width(right))) + right + " "
        _ui_add(scr, y, 2, text, curses.A_REVERSE if selected else 0)
        y += 1

    _ui_add(scr, h - 2, 2, msg or "就绪", _ui_color(4))
    _ui_add(scr, h - 1, 2,
            " ↑/↓ 选择   Enter 执行   q 退出   快捷键见右侧方括号 ",
            curses.A_DIM)


def _ui_vm_edit(scr, vmid) -> None:
    fields = ["mode", "compress", "local_prune",
              "delete_local", "verify_hash", "enabled"]
    while True:
        cfg = load_conf()
        guests = guest_map()
        p = target_params(cfg, vmid, guests)
        opts = [
            f"备份模式        {p['mode']}",
            f"压缩算法        {p['compress']}",
            f"本机保留        {p['local_prune']}",
            f"上传后删本地    {'是' if p['delete_local'] == '1' else '否'}",
            f"SHA256 校验     {'是' if p['verify_hash'] == '1' else '否'}",
            f"启用备份        {'是' if p['enabled'] else '否'}",
            "完成并返回",
        ]
        idx = _ui_choice(scr, f"VM {vmid} · {p['name'] or '-'} 参数", opts)
        if idx is None or idx == len(opts) - 1:
            return
        key = fields[idx]
        vm = cfg["vms"].setdefault(vmid, {"enabled": "1"})
        if key == "mode":
            v = _ui_choice(scr, "备份模式", ["snapshot（快照，不停机）",
