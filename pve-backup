]


def manual_menu(cfg: dict) -> None:
    idx = pick("手动备份", [
        "执行一次完整备份 + 上传",
        "只补传本地未上传的备份",
        "返回",
    ])
    if idx == 0:
        act_run(cfg)
    elif idx == 1:
        act_upload(cfg)


def service_menu(cfg: dict) -> None:
    while True:
        total = sum(1 for v in cfg["vms"]
                    if str(cfg["vms"][v].get("enabled", "1")).strip() != "0")
        auto = str(cfg["global"].get("auto_enabled", "1")) == "1"
        running = run_capture(["systemctl", "is-active", DAEMON_UNIT]) == "active"

        if total == 0:
            state = "未配置虚拟机"
            toggle_label = "开启自动备份"
            is_on = False
        elif auto and running:
            state = "已开启（调度服务运行中）"
            toggle_label = "关闭自动备份"
            is_on = True
        elif auto:
            state = "已启用但服务未运行"
            toggle_label = "关闭自动备份"
            is_on = True
        else:
            state = "已关闭"
            toggle_label = "开启自动备份"
            is_on = False

        idx = pick(f"服务管理（当前：{state}）", [
            toggle_label,
            "重新注册备份服务",
            "重置调度状态",
            "卸载备份服务",
            "返回",
        ])
        if idx is None or idx == 4:
            return

        if idx == 0:
            if is_on:
                cfg["global"]["auto_enabled"] = "0"
                save_conf(cfg)
                sync_service(cfg)
                print("已关闭自动备份（手动备份仍可用）")
            else:
                cfg["global"]["auto_enabled"] = "1"
                save_conf(cfg)
                sync_service(cfg)
                print("已开启自动备份（调度服务常驻运行）")
        elif idx == 1:
            do_install(cfg, argparse.Namespace(url=None, user=None, passwd=None,
                                               force=True, no_timer=False, vmid=None,
                                               preserve_state=True))
        elif idx == 2:
            do_reset()
        elif idx == 3:
            if confirm("确认卸载备份服务？配置和备份会保留", "是，卸载", "否，取消"):
                do_uninstall()

        try:
            input("\n按回车返回...")
        except (EOFError, KeyboardInterrupt):
            return


def _dispatch(key: str, cfg: dict) -> None:
    if key == "status":
        act_status(cfg)
    elif key == "manual":
        manual_menu(cfg)
    elif key == "list":
        act_list(cfg)
    elif key == "vms":
        interactive_vm_menu(cfg)
    elif key == "config":
        act_config(cfg)
    elif key == "edit":
        edit_global_config(cfg)
    elif key == "service":
        service_menu(cfg)


def interactive_menu() -> None:
    while True:
        idx = pick("PVE 备份管理", [label for _, label in ITEMS])
        if idx is None:
            break
        key = ITEMS[idx][0]
        if key == "quit":
            break
        cfg = load_conf()
        try:
            _dispatch(key, cfg)
        except Exception as e:
            print(f"\n执行出错: {e}")
        try:
            input("\n按回车返回菜单...")
        except (EOFError, KeyboardInterrupt):
            break


def plain_menu() -> None:
    while True:
        section("PVE 备份管理")
        for i, (_, label) in enumerate(ITEMS, 1):
            print(f"  {i}) {label}")
        print("")
        try:
            c = input("请选择: ").strip()
        except (EOFError, KeyboardInterrupt):
            return
        if c in ("0", "q", "Q"):
