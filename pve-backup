def _ui_add(scr, y, x, text, attr=0) -> None:
    """安全写屏：越界、写最后一格都不会抛异常。"""
    try:
        h, w = scr.getmaxyx()
        if y < 0 or y >= h or x < 0 or x >= w:
            return
        scr.addnstr(y, x, str(text), max(0, w - x - 1), attr)
    except Exception:
        pass


def _ui_box(scr, y, x, h, w, title="", attr=0) -> None:
    if h < 2 or w < 4:
        return
    _ui_add(scr, y, x, "┌" + "─" * (w - 2) + "┐")
    for i in range(1, h - 1):
        _ui_add(scr, y + i, x, "│")
        _ui_add(scr, y + i, x + w - 1, "│")
    _ui_add(scr, y + h - 1, x, "└" + "─" * (w - 2) + "┘")
    if title:
        _ui_add(scr, y, x + 2, f" {title} ", attr | curses.A_BOLD)


def _ui_key(scr):
    try:
