def log(msg: str) -> None:
    try:
        with open(LOG, "a", encoding="utf-8") as f:
            f.write(f"{dt.datetime.now():%Y-%m-%d %H:%M:%S} {msg}\n")
    except OSError:
        pass


def say(msg: str = "") -> None:
    print(msg)
    if LOGGING and msg.strip():
        log(msg)


def section(title: str) -> None:
    say("")
    say(LINE)
    say(f" {title}")
    say(LINE)


def pad(s, width: int) -> str:
    s = str(s)
    d = sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in s)
    return s + " " * max(0, width - d)


def hsize(n) -> str:
    try:
        n = float(n)
    except (TypeError, ValueError):
        return "0B"
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if n < 1024 or unit == "TiB":
            return f"{n:.0f}{unit}" if unit == "B" else f"{n:.1f}{unit}"
        n /= 1024
    return f"{n:.1f}TiB"


def run_capture(cmd) -> str:
    try:
        return subprocess.run(cmd, capture_output=True, text=True).stdout.strip()
    except Exception:
        return ""


def rclone_available() -> bool:
    return shutil.which("rclone") is not None


def require_rclone() -> bool:
    global RCLONE
    path = shutil.which("rclone")
    if path:
        RCLONE = path
        return True
    print(RCLONE_HINT, file=sys.stderr)
    log("错误: 未找到 rclone")
    return False


def rclone_config_get(remote: str, key: str) -> str:
    import configparser
    cp = configparser.ConfigParser(interpolation=None)
    try:
        cp.read(RCLONE_CONFIG)
    except configparser.Error:
        return ""
    if cp.has_section(remote):
        return cp.get(remote, key, fallback="")
    return ""


def configure_webdav(cfg: dict) -> None:
    if not require_rclone():
        return
    import getpass

    remote = cfg["global"].get("remote", "webdav")
    cur_url = rclone_config_get(remote, "url")
    cur_user = rclone_config_get(remote, "user")
    cur_pass = rclone_config_get(remote, "pass")

    print("")
    print("WebDAV 连接设置（凭证保存在 /root/.config/rclone/rclone.conf）")
    print("地址示例: http://192.168.50.4:5244/dav  （只填到 /dav，不带备份子目录）")
    try:
        url = input(f"地址 [{cur_url}]: ").strip() or cur_url
        user = input(f"用户名 [{cur_user}]: ").strip() or cur_user
        pwd = getpass.getpass("密码（留空保持当前）: ")
    except (EOFError, KeyboardInterrupt):
        return

    if not url or not user:
        print("地址和用户名不能为空")
        return

    if pwd:
        obscured = subprocess.run([RCLONE, "obscure", pwd],
                                  capture_output=True, text=True).stdout.strip()
    else:
        obscured = cur_pass

    cmd = [RCLONE, "config", "create", remote, "webdav",
           f"url={url}", "vendor=other", f"user={user}",
           "--config", RCLONE_CONFIG]
    if obscured:
        cmd.append(f"pass={obscured}")

    rc = subprocess.run(cmd, capture_output=True, text=True).returncode
    if rc != 0:
        print("保存失败，请检查 rclone 配置")
        return

    print("已保存，正在测试连接...")
    test = subprocess.run([RCLONE, "lsd", f"{remote}:"], capture_output=True, text=True)
    if test.returncode == 0:
        print("连接成功 ✅")
        log("WebDAV 凭证已更新，连接成功")
    else:
        msg = (test.stderr or test.stdout).strip().splitlines()
        print("连接失败 ❌")
        if msg:
            print("  " + msg[-1][:200])
        log("WebDAV 凭证已更新，但连接失败")


def notify_daemon() -> None:
    """配置保存后唤醒调度服务，让它立即重算下次时间。"""
    pid = run_capture(["systemctl", "show", "-p", "MainPID", "--value", DAEMON_UNIT])
    if pid.isdigit() and int(pid) > 0:
        try:
            os.kill(int(pid), signal.SIGHUP)
        except OSError:
            pass


# ------------------------------------------------------------ 推送通知
def push_notify(cfg: dict, status: str, message: str,
                title: str = "PVE 备份") -> bool:
    """把运行结果推送到 push-server（POST /api/push，无需鉴权）。

    status: ok / warn / error / info
    推送失败只记日志，不影响备份结果。
    """
    g = cfg.get("global", {})
    url = str(g.get("notify_url") or "").strip()
    if not url:
        return False
    base = url.rstrip("/")
    if not base.endswith("/api/push"):
        base += "/api/push"

    payload = {
        "server_name": host_label(cfg),
        "category": "service",
        "topic": str(g.get("notify_topic") or "server/pve-backup"),
        "title": title or "PVE 备份",
        "message": message,
        "status": status if status in ("ok", "warn", "error", "info") else "info",
        "push_to_mqtt": True,
        "msg_type": "markdown",
        "mode": "append",
    }
    data = json.dumps(payload, ensure_ascii=False).encode("utf-8")
    req = urllib.request.Request(
        base, data=data, method="POST",
        headers={"Content-Type": "application/json; charset=utf-8"})
    try:
        timeout = float(g.get("notify_timeout") or 10)
    except ValueError:
        timeout = 10

    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            body = resp.read().decode("utf-8", "replace")
            try:
                obj = json.loads(body)
            except ValueError:
                obj = {}
            ok = resp.status == 200 and int(obj.get("code", 200)) == 200
            say(f"  [推送] {'已发送' if ok else '服务返回异常'}: {body[:200]}")
            return ok
    except (urllib.error.URLError, OSError, ValueError) as e:
        say(f"  [推送] 发送失败: {e}")
        return False


def notify_allowed(cfg: dict, failed: bool) -> bool:
    on = str(cfg.get("global", {}).get("notify_on", "always")).strip().lower()
    if on == "never":
        return False
    if on == "failure" and not failed:
        return False
    return bool(str(cfg.get("global", {}).get("notify_url") or "").strip())


def notify_run_summary(cfg: dict, rows: list, run_dirs: list,
                       total_sec: int, failed: bool) -> None:
    if not notify_allowed(cfg, failed):
        return
    ok_n = sum(1 for r in rows if r[5] == "ok")
    fail_n = sum(1 for r in rows if r[5] in ("failed", "backup-failed"))
    size = sum(r[3] for r in rows if r[5] == "ok")
    lines = [
        f"**主机**：{host_label(cfg)}",
        f"**时间**：{dt.datetime.now():%Y-%m-%d %H:%M:%S}",
        f"**耗时**：{total_sec}s",
        f"**虚拟机**：{len(rows)} 台｜成功 {ok_n}｜失败 {fail_n}",
        f"**上传**：{hsize(size)}",
        "**远端**：" + "、".join(f"`{d}`" for d in run_dirs),
        "",
        "| VMID | 名称 | 文件 | 大小 | 结果 |",
        "| --- | --- | --- | --- | --- |",
    ]
    for vmid, name, base, fsize, _dur, st in rows:
        lines.append(f"| {vmid} | {name or '-'} | {base} | {hsize(fsize)} | {st} |")
    push_notify(cfg, "error" if failed else "ok", "\n".join(lines),
                title=f"PVE 备份 · {host_label(cfg)}")


def run_stream(cmd, to_log: bool = False, quiet: bool = False) -> int:
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            text=True, bufsize=1, errors="replace")
    logf = open(LOG, "a", encoding="utf-8") if to_log else None
    try:
        for line in proc.stdout:
            if not quiet:
                print(line, end="", flush=True)
            if logf:
                logf.write(line)
        rc = proc.wait()
    finally:
        if logf:
            logf.close()
    return rc


def acquire_lock(timeout: int = 3600):
    f = open(LOCK, "w")
    start = time.time()
    while True:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return f
        except BlockingIOError:
            if time.time() - start > timeout:
                f.close()
                return None
            time.sleep(1)


def archive_files(dumpdir: str, vmid: str = None) -> list:
    out = set()
    for pat in ARCHIVE_PATTERNS:
        if vmid is not None:
            pat = pat.replace("vzdump-*", f"vzdump-*-{vmid}-*", 1)
        out.update(glob.glob(os.path.join(dumpdir, pat)))
    return sorted(out)


# ------------------------------------------------------------------ 备份计划
DAY_MAP = {"mon": "Mon", "tue": "Tue", "wed": "Wed", "thu": "Thu",
           "fri": "Fri", "sat": "Sat", "sun": "Sun"}


def normalize_schedule(spec: str) -> str:
    """把友好写法转换为 systemd OnCalendar；也接受原生 OnCalendar。"""
    spec = (spec or "").strip()
    if not spec:
        return ""

    def norm_time(t: str) -> str:
        return t if t.count(":") >= 2 else (t + ":00" if t.count(":") == 1 else t)

    parts = spec.split()
    head = parts[0].lower()
    if head == "daily" and len(parts) == 2:
        return f"*-*-* {norm_time(parts[1])}"
    if head == "weekly" and len(parts) == 3:
        day = DAY_MAP.get(parts[1].lower()[:3])
        if not day:
            raise ValueError(f"无效的星期: {parts[1]}（可用 mon/tue/wed/thu/fri/sat/sun）")
        return f"{day} *-*-* {norm_time(parts[2])}"
    if head == "monthly" and len(parts) == 3:
        if not parts[1].isdigit() or not 1 <= int(parts[1]) <= 31:
            raise ValueError(f"无效的日期: {parts[1]}（1-31）")
        return f"*-*-{int(parts[1]):02d} {norm_time(parts[2])}"
    return spec


def schedule_valid(spec: str) -> bool:
    if not spec:
        return True
    return subprocess.run(["systemd-analyze", "calendar", spec],
                          capture_output=True).returncode == 0


def next_run(spec: str, base: dt.datetime = None):
    """计算 base 之后的下一次触发时间。"""
    try:
        expr = normalize_schedule(spec)
    except ValueError:
        return None
    if not expr:
        return None
    if base is None:
        base = dt.datetime.now()
    try:
        out = subprocess.run(
            ["systemd-analyze", "calendar",
             f"--base-time={base:%Y-%m-%d %H:%M:%S}", "--iterations=1", expr],
            capture_output=True, text=True,
        )
    except OSError:
        return None
    if out.returncode != 0:
        return None
    m = re.search(r"Next elapse:\s+\w+\s+(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2})", out.stdout)
    if not m:
        return None
    return dt.datetime.strptime(m.group(1), "%Y-%m-%d %H:%M:%S")


def _state_dt(v):
    if isinstance(v, dict):
        vals = [x for x in v.values() if isinstance(x, str) and x]
        return max(vals) if vals else None
    return v if isinstance(v, str) and v else None


def load_state() -> dict:
    raw = {}
    try:
        with open(STATE_FILE, encoding="utf-8") as f:
            raw = json.load(f)
    except (OSError, ValueError):
        raw = {}
    if not isinstance(raw, dict):
        raw = {}
    if "last" in raw or "ran" in raw:
        return {"last": _state_dt(raw.get("last")), "ran": _state_dt(raw.get("ran"))}
    # 兼容旧的按 VM / 旧结构
    return {"last": _state_dt(raw), "ran": None}


def save_state(state: dict) -> None:
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        tmp = STATE_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump({"last": state.get("last"), "ran": state.get("ran")},
                      f, ensure_ascii=False, indent=2)
        os.replace(tmp, STATE_FILE)
    except OSError:
        pass


def parse_iso(s):
    try:
        return dt.datetime.fromisoformat(s)
    except (TypeError, ValueError):
        return None


# ------------------------------------------------------------------ 配置
def guest_map() -> dict:
    node = run_capture(["hostname"]) or "pve"
    m = {}
    for kind, path in (("qemu", f"/nodes/{node}/qemu"), ("lxc", f"/nodes/{node}/lxc")):
        raw = run_capture(["pvesh", "get", path, "--output-format", "json"])
        try:
            items = json.loads(raw or "[]")
        except Exception:
            items = []
        for it in items:
            m[str(it.get("vmid", ""))] = {
                "name": it.get("name", "-"),
                "status": it.get("status", "-"),
                "type": kind,
                "maxdisk": float(it.get("maxdisk", 0) or 0),
            }
    return m


def _apply_fixed(cfg: dict) -> None:
    g = cfg["global"]
    g["schedule"] = FIXED_SCHEDULE
    g["storage"] = FIXED_STORAGE
    g["dumpdir"] = FIXED_DUMPDIR
    g["remote"] = FIXED_REMOTE


def _migrate_paths(cfg: dict) -> None:
    g = cfg["global"]
    old = str(g.pop("remote_subdir", "") or "").strip()
    if not str(g.get("remote_paths", "") or "").strip() and old:
        g["remote_paths"] = old


def load_conf() -> dict:
    cfg = {"global": dict(GLOBAL_DEFAULTS), "vms": {}}
    if not os.path.isfile(CONF):
        return cfg

    with open(CONF, encoding="utf-8") as f:
        text = f.read()

    if "[" not in text:
        return migrate_legacy(text, cfg)

    cp = configparser.ConfigParser(interpolation=None)
    try:
        cp.read_string(text)
    except configparser.Error:
        return cfg

    if cp.has_section("global"):
        for k, v in cp.items("global"):
            cfg["global"][k] = v
    # 已移除的旧选项
    cfg["global"].pop("upload_failure_fatal", None)
    cfg["global"].pop("retention", None)

    for sect in cp.sections():
        if sect.startswith("vm:"):
            vmid = sect.split(":", 1)[1].strip()
            if vmid:
                cfg["vms"][vmid] = {k: v for k, v in cp.items(sect)}
                for legacy in ("name", "schedule", "retention", "remote_subdir", "remote_keep"):
                    cfg["vms"][vmid].pop(legacy, None)
    _migrate_paths(cfg)
    _apply_fixed(cfg)
    return cfg


def migrate_legacy(text: str, cfg: dict) -> dict:
    """把旧的 KEY=value 配置迁移为 INI 格式。"""
    legacy = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        v = v.strip()
        if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
            v = v[1:-1]
        legacy[k.strip()] = v

    for old, new in LEGACY_MAP.items():
        if old in legacy:
            cfg["global"][new] = legacy[old]

    ids = legacy.get("VMIDS", "all").strip()
    if ids.lower() == "all":
        targets = list(guest_map().keys())
    else:
        targets = ids.split()
    for vmid in targets:
        cfg["vms"][vmid] = {"enabled": "1"}

    _migrate_paths(cfg)
    _apply_fixed(cfg)
    save_conf(cfg)
    log(f"配置已从旧格式迁移为 INI（{len(cfg['vms'])} 台虚拟机）")
    return cfg


def save_conf(cfg: dict) -> None:
    cfg["global"].pop("upload_failure_fatal", None)
    cp = configparser.ConfigParser(interpolation=None)
    cp["global"] = {k: str(v) for k, v in cfg["global"].items()}
    for vmid in sorted(cfg["vms"], key=lambda x: int(x) if x.isdigit() else 0):
        vm = cfg["vms"][vmid]
        cp[f"vm:{vmid}"] = {k: str(v) for k, v in vm.items() if str(v) != ""}
    with open(CONF, "w", encoding="utf-8") as f:
        f.write(f"# 由 {SELF_PATH} 生成 {dt.datetime.now():%Y-%m-%d %H:%M:%S}\n")
        cp.write(f)
    os.chmod(CONF, 0o644)
    notify_daemon()


def target_params(cfg: dict, vmid: str, guests: dict = None) -> dict:
    """返回某台虚拟机的生效参数（未设置的继承全局）。名称始终来自 PVE。"""
    g = cfg["global"]
    vm = cfg["vms"].get(str(vmid), {})
    if guests is None:
        guests = guest_map()
    name = str(guests.get(str(vmid), {}).get("name", "")).strip()

    def pick(key, default=""):
        v = str(vm.get(key, "")).strip()
        return v if v else str(g.get(key, default))

    return {
        "vmid": str(vmid),
        "name": name,
        "enabled": str(vm.get("enabled", "1")).strip() != "0",
        "storage": str(g.get("storage", "local")),
        "dumpdir": str(g.get("dumpdir", "/var/lib/vz/dump")),
        "mode": pick("mode", "snapshot"),
        "compress": pick("compress", "zstd"),
        "local_prune": pick("local_prune", "keep-last=3"),
        "remote": str(g.get("remote", "webdav")),
        "delete_local": pick("delete_local", "0"),
        "verify_hash": pick("verify_hash", "0"),
        "rclone_retries": str(g.get("rclone_retries", "5")),
        "rclone_timeout": str(g.get("rclone_timeout", "10m")),
    }


def enabled_vmids(cfg: dict) -> list:
    return [vmid for vmid in sorted(cfg["vms"], key=lambda x: int(x) if x.isdigit() else 0)
            if str(cfg["vms"][vmid].get("enabled", "1")).strip() != "0"]


def rclone_remote_exists(remote: str) -> bool:
    if not rclone_available():
        return False
    try:
        out = subprocess.run([RCLONE, "listremotes", "--config", RCLONE_CONFIG],
                             capture_output=True, text=True)
    except OSError:
        return False
    return any(x.strip() == f"{remote}:" for x in out.stdout.splitlines())


# ------------------------------------------------------------------ 上传
def remote_file_size(p: dict, remote_path: str):
    out = subprocess.run([RCLONE, "lsl", remote_path, "--config", RCLONE_CONFIG],
                         capture_output=True, text=True)
    if out.returncode != 0 or not out.stdout.strip():
        return None
    try:
        return int(out.stdout.strip().splitlines()[0].split()[0])
    except (ValueError, IndexError):
        return None


def sha256_local(path: str) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def sha256_remote(remote_path: str) -> str:
    proc = subprocess.Popen([RCLONE, "cat", remote_path, "--config", RCLONE_CONFIG],
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    h = hashlib.sha256()
    for chunk in iter(lambda: proc.stdout.read(1024 * 1024), b""):
        h.update(chunk)
    proc.wait()
    return h.hexdigest()


def upload_file(p: dict, path: str, remote_dir: str, allow_delete: bool = True):
    base = os.path.basename(path)
    size = os.path.getsize(path)
    remote = f"{remote_dir}/{base}"

    rsize = remote_file_size(p, remote)
    if rsize == size:
        say(f"  [跳过] {base} —— 远端已存在且大小一致")
        return ("skipped", size, 0)

    say(f"  [上传] {base} ({hsize(size)}) -> {remote_dir}/")
    t0 = time.time()
    rc = run_stream([
        RCLONE, "copyto", path, remote,
        "--config", RCLONE_CONFIG,
        "--checksum",
        "--retries", p["rclone_retries"],
        "--low-level-retries", "20",
        "--timeout", p["rclone_timeout"],
        "--contimeout", "30s",
        "--stats", "5s", "--stats-one-line",
        "--log-level", "INFO",
    ], to_log=True)
    dur = max(1, int(time.time() - t0))

    if rc != 0:
        say(f"  [失败] {base} —— rclone 退出码 {rc}")
        return ("failed", size, dur)

    rsize = remote_file_size(p, remote)
    if rsize != size:
        say(f"  [失败] {base} —— 大小不一致 本地={size} 远端={rsize}")
        return ("failed", size, dur)

    if p["verify_hash"] == "1":
        say("  [校验] 计算 SHA256 ...")
        lh = sha256_local(path)
        rh = sha256_remote(remote)
        if lh != rh:
            say(f"  [失败] {base} —— SHA256 不一致")
            return ("failed", size, dur)
        say(f"  [校验] SHA256 一致: {lh}")

    say(f"  [完成] {base} 用时 {dur}s，平均 {hsize(size // dur)}/s")

    if allow_delete and p["delete_local"] == "1":
        try:
            os.remove(path)
            say(f"  [清理] 已删除本地 {base}")
        except OSError as e:
            say(f"  [警告] 删除本地失败: {e}")

    return ("ok", size, dur)


RUN_DIR_RE = re.compile(r"^\d{4}-\d{2}-\d{2}_\d{2}:\d{2}$")


def run_dir_name(ts: dt.datetime = None) -> str:
    # 时间目录会同步到 Windows/SMB：用中文写法最直观，且不含非法字符
    # 例：2026年11月13日 11点50分
    t = ts or dt.datetime.now()
    return f"{t:%Y年%m月%d日 %H点%M分}"


def remote_paths(cfg: dict) -> list:
    g = cfg["global"]
    raw = str(g.get("remote_paths", "") or "").strip()
    if not raw:
        raw = str(g.get("remote_subdir", "") or "").strip()
    if not raw:
        return []
    raw = raw.replace("，", ",")
    parts = raw.splitlines() if "\n" in raw else raw.split(",")
    return [p.strip().strip("/") for p in parts if p.strip()]


def host_label(cfg: dict) -> str:
    host = str(cfg["global"].get("host_name", "") or "").strip().strip("/")
    return host or socket.gethostname()


def remote_bases(cfg: dict) -> list:
    remote = cfg["global"].get("remote", "webdav")
    host = host_label(cfg)
    return [f"{remote}:{p}/{host}" for p in remote_paths(cfg)]


def list_run_dirs(base: str) -> list:
    out = run_capture([RCLONE, "lsf", base, "--config", RCLONE_CONFIG, "--dirs-only"])
    names = [x.strip().rstrip("/") for x in out.splitlines() if x.strip()]
    return sorted(n for n in names if RUN_DIR_RE.match(n))


def enforce_folder_keep(cfg: dict):
    """对每个远端目录，只保留最新 N 个时间文件夹，超出的整个文件夹删除。"""
    keep = str(cfg["global"].get("remote_keep", "")).strip()
    if not keep.isdigit() or int(keep) <= 0:
        return None
    keep = int(keep)
    msgs = []
    for base in remote_bases(cfg):
        dirs = list_run_dirs(base)
        if len(dirs) <= keep:
            msgs.append(f"{base}: {len(dirs)} 个")
            continue
        removed = 0
        for name in dirs[:-keep]:
            rc = subprocess.run([RCLONE, "purge", f"{base}/{name}",
                                 "--config", RCLONE_CONFIG],
                                capture_output=True, text=True).returncode
            if rc == 0:
                removed += 1
        msgs.append(f"{base}: 删除 {removed} 个，保留 {keep} 个")
    return "；".join(msgs) if msgs else None


