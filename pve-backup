def add_vm(cfg: dict, vmid: str, values: dict, overwrite: bool = False) -> bool:
    vmid = str(vmid).strip()
    if not vmid.isdigit():
        print(f"无效 VMID: {vmid}")
        return False
    guests = guest_map()
    if vmid not in guests:
        print(f"错误: 当前节点不存在 VMID {vmid}，不能添加")
        return False
    if vmid in cfg["vms"] and not overwrite:
        print(f"VMID {vmid} 已存在，使用 edit 修改")
        return False
    vm = cfg["vms"].get(vmid, {})
    vm["enabled"] = vm.get("enabled", "1")
    for k, v in values.items():
        if v is not None:
            vm[k] = str(v)
    cfg["vms"][vmid] = vm
    save_conf(cfg)
    sync_service(cfg)
    print(f"已{'更新' if overwrite else '添加'} VM {vmid}")
    return True


def remove_vm(cfg: dict, vmid: str) -> bool:
    vmid = str(vmid)
    if vmid not in cfg["vms"]:
        print(f"VMID {vmid} 不在配置中")
        return False
    del cfg["vms"][vmid]
    save_conf(cfg)
    sync_service(cfg)
    print(f"已移除 VM {vmid}（备份文件不会被删除）")
    return True


def parse_vm_options(rest: list) -> dict:
    ap = argparse.ArgumentParser(prog="pve-backup")
    ap.add_argument("vmid")
    ap.add_argument("--mode", choices=["snapshot", "suspend", "stop"])
    ap.add_argument("--compress", choices=["zstd", "gzip", "lzo", "0"])
    ap.add_argument("--prune", help="本机保留，如 keep-last=3")
    ap.add_argument("--delete-local", action="store_true")
    ap.add_argument("--keep-local", action="store_true")
    ap.add_argument("--verify-hash", action="store_true")
    ap.add_argument("--no-verify-hash", action="store_true")
    ap.add_argument("--enable", action="store_true")
    ap.add_argument("--disable", action="store_true")
    return vars(ap.parse_args(rest))


def vm_values_from_args(a: dict) -> dict:
    v = {}
    for src, dst in (("mode", "mode"), ("compress", "compress"),
                     ("prune", "local_prune")):
        if a.get(src) is not None:
            v[dst] = a[src]
    if a.get("delete_local"):
        v["delete_local"] = "1"
    if a.get("keep_local"):
        v["delete_local"] = "0"
    if a.get("verify_hash"):
        v["verify_hash"] = "1"
    if a.get("no_verify_hash"):
        v["verify_hash"] = "0"
    if a.get("enable"):
        v["enabled"] = "1"
    if a.get("disable"):
        v["enabled"] = "0"
    return v


# ------------------------------------------------------------------ 选择器
def pick(title: str, options: list, default: int = 0,
         footer: str = "↑/↓ 或 j/k 选择   Enter 确认   q 取消"):
    """上下键选择器；返回索引，取消返回 None。非终端环境退化为数字菜单。"""
    if not options:
        return None
    if curses is None or not (sys.stdin.isatty() and sys.stdout.isatty()):
        print(f"\n{title}")
        for i, opt in enumerate(options, 1):
            print(f"  {i}) {opt}")
        try:
            c = input("请选择: ").strip()
        except (EOFError, KeyboardInterrupt):
            return None
        if c.isdigit() and 1 <= int(c) <= len(options):
            return int(c) - 1
        return None

    def _loop(stdscr):
        stdscr.keypad(True)
        try:
            curses.curs_set(0)
        except Exception:
            pass
        pos = min(max(default, 0), len(options) - 1)
        while True:
            stdscr.clear()
            h, w = stdscr.getmaxyx()
            try:
                stdscr.addstr(1, 2, title, curses.A_BOLD)
                stdscr.addstr(2, 2, LINE[: max(0, w - 4)])
            except Exception:
                pass
            for i, opt in enumerate(options):
                attr = curses.A_REVERSE if i == pos else curses.A_NORMAL
                try:
                    stdscr.addstr(4 + i, 4, f"  {opt}  ", attr)
                except Exception:
                    pass
            try:
                stdscr.addstr(4 + len(options) + 1, 2, footer)
                stdscr.refresh()
            except Exception:
                pass
            ch = stdscr.getch()
            if ch in (curses.KEY_UP, ord("k")):
                pos = (pos - 1) % len(options)
            elif ch in (curses.KEY_DOWN, ord("j")):
                pos = (pos + 1) % len(options)
            elif ch in (10, 13, curses.KEY_ENTER):
                return pos
            elif ch in (ord("q"), 27):
                return None

    return curses.wrapper(_loop)


def confirm(title: str, yes: str = "是，继续", no: str = "否，取消") -> bool:
    idx = pick(title, [no, yes], default=0)
    return idx == 1


def pick_vm(cfg: dict, title: str):
    vms = sorted(cfg["vms"], key=lambda x: int(x) if x.isdigit() else 0)
    if not vms:
        print("尚无已配置的虚拟机")
