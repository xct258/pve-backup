# ------------------------------------------------------------------ 配置
def guest_map() -> dict:
    node = run_capture(["hostname"]) or "pve"
    m = {}
    for kind, path in (("qemu", f"/nodes/{node}/qemu"), ("lxc", f"/nodes/{node}/lxc")):
        raw = run_capture(["pvesh", "get", path, "--output-format", "json"])
        try:
            items = json.loads(raw or "[]")
        except Exception:
            items = []
        for it in items:
            m[str(it.get("vmid", ""))] = {
                "name": it.get("name", "-"),
                "status": it.get("status", "-"),
                "type": kind,
                "maxdisk": float(it.get("maxdisk", 0) or 0),
            }
    return m


def _apply_fixed(cfg: dict) -> None:
    g = cfg["global"]
    g["schedule"] = FIXED_SCHEDULE
    g["storage"] = FIXED_STORAGE
    g["dumpdir"] = FIXED_DUMPDIR
    g["remote"] = FIXED_REMOTE


def _migrate_paths(cfg: dict) -> None:
    g = cfg["global"]
    old = str(g.pop("remote_subdir", "") or "").strip()
    if not str(g.get("remote_paths", "") or "").strip() and old:
        g["remote_paths"] = old


def load_conf() -> dict:
    cfg = {"global": dict(GLOBAL_DEFAULTS), "vms": {}}
    if not os.path.isfile(CONF):
        return cfg

    with open(CONF, encoding="utf-8") as f:
        text = f.read()

    if "[" not in text:
        return migrate_legacy(text, cfg)

    cp = configparser.ConfigParser(interpolation=None)
    try:
        cp.read_string(text)
    except configparser.Error:
        return cfg

    if cp.has_section("global"):
        for k, v in cp.items("global"):
            cfg["global"][k] = v
    # 已移除的旧选项
    cfg["global"].pop("upload_failure_fatal", None)
    cfg["global"].pop("retention", None)

    for sect in cp.sections():
        if sect.startswith("vm:"):
            vmid = sect.split(":", 1)[1].strip()
            if vmid:
                cfg["vms"][vmid] = {k: v for k, v in cp.items(sect)}
                for legacy in ("name", "schedule", "retention", "remote_subdir", "remote_keep"):
                    cfg["vms"][vmid].pop(legacy, None)
    _migrate_paths(cfg)
    _apply_fixed(cfg)
    return cfg


def migrate_legacy(text: str, cfg: dict) -> dict:
    """把旧的 KEY=value 配置迁移为 INI 格式。"""
    legacy = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        v = v.strip()
        if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
            v = v[1:-1]
        legacy[k.strip()] = v

    for old, new in LEGACY_MAP.items():
        if old in legacy:
            cfg["global"][new] = legacy[old]

    ids = legacy.get("VMIDS", "all").strip()
    if ids.lower() == "all":
        targets = list(guest_map().keys())
    else:
        targets = ids.split()
    for vmid in targets:
        cfg["vms"][vmid] = {"enabled": "1"}

    _migrate_paths(cfg)
    _apply_fixed(cfg)
    save_conf(cfg)
    log(f"配置已从旧格式迁移为 INI（{len(cfg['vms'])} 台虚拟机）")
    return cfg


def save_conf(cfg: dict) -> None:
    cfg["global"].pop("upload_failure_fatal", None)
    cp = configparser.ConfigParser(interpolation=None)
    cp["global"] = {k: str(v) for k, v in cfg["global"].items()}
    for vmid in sorted(cfg["vms"], key=lambda x: int(x) if x.isdigit() else 0):
        vm = cfg["vms"][vmid]
        cp[f"vm:{vmid}"] = {k: str(v) for k, v in vm.items() if str(v) != ""}
    with open(CONF, "w", encoding="utf-8") as f:
        f.write(f"# 由 {SELF_PATH} 生成 {dt.datetime.now():%Y-%m-%d %H:%M:%S}\n")
        cp.write(f)
    os.chmod(CONF, 0o644)
    notify_daemon()


def target_params(cfg: dict, vmid: str, guests: dict = None) -> dict:
    """返回某台虚拟机的生效参数（未设置的继承全局）。名称始终来自 PVE。"""
    g = cfg["global"]
    vm = cfg["vms"].get(str(vmid), {})
    if guests is None:
        guests = guest_map()
    name = str(guests.get(str(vmid), {}).get("name", "")).strip()

    def pick(key, default=""):
        v = str(vm.get(key, "")).strip()
        return v if v else str(g.get(key, default))

    return {
        "vmid": str(vmid),
        "name": name,
        "enabled": str(vm.get("enabled", "1")).strip() != "0",
        "storage": str(g.get("storage", "local")),
        "dumpdir": str(g.get("dumpdir", "/var/lib/vz/dump")),
        "mode": pick("mode", "snapshot"),
        "compress": pick("compress", "zstd"),
        "local_prune": pick("local_prune", "keep-last=3"),
        "remote": str(g.get("remote", "webdav")),
        "delete_local": pick("delete_local", "0"),
        "verify_hash": pick("verify_hash", "0"),
        "rclone_retries": str(g.get("rclone_retries", "5")),
        "rclone_timeout": str(g.get("rclone_timeout", "10m")),
    }


def enabled_vmids(cfg: dict) -> list:
    return [vmid for vmid in sorted(cfg["vms"], key=lambda x: int(x) if x.isdigit() else 0)
            if str(cfg["vms"][vmid].get("enabled", "1")).strip() != "0"]


def rclone_remote_exists(remote: str) -> bool:
    if not rclone_available():
        return False
    try:
        out = subprocess.run([RCLONE, "listremotes", "--config", RCLONE_CONFIG],
                             capture_output=True, text=True)
    except OSError:
        return False
    return any(x.strip() == f"{remote}:" for x in out.stdout.splitlines())


# ------------------------------------------------------------------ 上传
def remote_file_size(p: dict, remote_path: str):
    out = subprocess.run([RCLONE, "lsl", remote_path, "--config", RCLONE_CONFIG],
                         capture_output=True, text=True)
    if out.returncode != 0 or not out.stdout.strip():
        return None
    try:
        return int(out.stdout.strip().splitlines()[0].split()[0])
    except (ValueError, IndexError):
        return None


def sha256_local(path: str) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def sha256_remote(remote_path: str) -> str:
    proc = subprocess.Popen([RCLONE, "cat", remote_path, "--config", RCLONE_CONFIG],
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    h = hashlib.sha256()
    for chunk in iter(lambda: proc.stdout.read(1024 * 1024), b""):
        h.update(chunk)
    proc.wait()
    return h.hexdigest()


def upload_file(p: dict, path: str, remote_dir: str, allow_delete: bool = True):
    base = os.path.basename(path)
    size = os.path.getsize(path)
    remote = f"{remote_dir}/{base}"

    rsize = remote_file_size(p, remote)
    if rsize == size:
        say(f"  [跳过] {base} —— 远端已存在且大小一致")
        return ("skipped", size, 0)

    say(f"  [上传] {base} ({hsize(size)}) -> {remote_dir}/")
    t0 = time.time()
    rc = run_stream([
        RCLONE, "copyto", path, remote,
        "--config", RCLONE_CONFIG,
        "--checksum",
        "--retries", p["rclone_retries"],
        "--low-level-retries", "20",
        "--timeout", p["rclone_timeout"],
        "--contimeout", "30s",
        "--stats", "5s", "--stats-one-line",
        "--log-level", "INFO",
    ], to_log=True)
    dur = max(1, int(time.time() - t0))

    if rc != 0:
        say(f"  [失败] {base} —— rclone 退出码 {rc}")
        return ("failed", size, dur)

    rsize = remote_file_size(p, remote)
    if rsize != size:
        say(f"  [失败] {base} —— 大小不一致 本地={size} 远端={rsize}")
        return ("failed", size, dur)

    if p["verify_hash"] == "1":
        say("  [校验] 计算 SHA256 ...")
        lh = sha256_local(path)
        rh = sha256_remote(remote)
        if lh != rh:
            say(f"  [失败] {base} —— SHA256 不一致")
            return ("failed", size, dur)
        say(f"  [校验] SHA256 一致: {lh}")

    say(f"  [完成] {base} 用时 {dur}s，平均 {hsize(size // dur)}/s")

    if allow_delete and p["delete_local"] == "1":
        try:
            os.remove(path)
            say(f"  [清理] 已删除本地 {base}")
        except OSError as e:
            say(f"  [警告] 删除本地失败: {e}")

    return ("ok", size, dur)


