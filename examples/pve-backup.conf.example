# pve-backup 配置示例：复制到 /etc/pve-backup.conf 后按需修改
# 每台虚拟机对应一个 [vm:VMID] 段，留空的字段继承 [global]
[global]
storage = local
dumpdir = /var/lib/vz/dump
mode = snapshot
compress = zstd
local_prune = keep-last=3
remote = webdav
host_name = pve-node1
remote_keep = 6
delete_local = 0
verify_hash = 0
schedule = monthly 1 00:00
auto_enabled = 1
rclone_retries = 5
rclone_timeout = 10m

# 推送通知（push-server）
notify_url = https://push-server.o1-1.xct258.top
notify_topic = server/pve-backup
notify_on = always
notify_timeout = 10

[remote:cloud/pve-backup]
keep = 6
enabled = 1

[remote:nas/pve-backup]
keep = 3
enabled = 1

[vm:100]
enabled = 1
# remote_keep = 2   # 该 VM 云端保留份数，留空跟随目录设置
mode = snapshot
compress = zstd
local_prune = keep-last=2
delete_local = 1

[vm:101]
enabled = 1
mode = snapshot
compress = gzip
local_prune = keep-last=2
delete_local = 1

